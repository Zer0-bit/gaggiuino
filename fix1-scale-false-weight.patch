+bool scalesTare(void) {
   if (hwScalesPresent) {
     auto& loadCells = LoadCellSingleton::getInstance();
-    if (loadCells.wait_ready_timeout(150, 10)) {
-      loadCells.tare(4);
+    for (uint8_t attempt = 0; attempt < 3; attempt++) {
+      if (loadCells.wait_ready_timeout(150, 10)) {
+        loadCells.tare(4);
+        return true;
+      }
     }
+    return false;
   }
   else if (remoteScalesIsPresent()) {
     remoteScalesTare();
+    return true;
   }
+  return false;
 }
 
